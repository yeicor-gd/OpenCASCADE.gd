<?xml version='1.0' encoding='utf-8'?>
<class name="OcgGraphic3dVertex" inherits="RefCounted">
    <brief_description>This class represents a graphical 3D point.</brief_description>
    <description>! This class represents a graphical 3D point.</description>
    <methods>
        <method name="default" qualifiers="static">
            <description>Creates a point with 0.0, 0.0, 0.0 coordinates.</description>
        </method>
        <method name="from_2" qualifiers="static">
            <description>Creates a point with theX, theY and theZ coordinates.</description>
        </method>
        <method name="from_3" qualifiers="static">
            <description>Creates a point with theX, theY and theZ coordinates.</description>
        </method>
        <method name="SetCoord_1">
            <description>Modifies the coordinates.</description>
        </method>
        <method name="SetCoord_2">
            <description>Modifies the coordinates.</description>
        </method>
        <method name="Coord_1" qualifiers="const">
            <description>Returns the coordinates.</description>
        </method>
        <method name="Coord_2" qualifiers="const">
            <description>Returns the coordinates.</description>
        </method>
        <method name="X" qualifiers="const">
            <description>Returns the X coordinates.</description>
        </method>
        <method name="Y" qualifiers="const">
            <description>Returns the Y coordinate.</description>
        </method>
        <method name="Z" qualifiers="const">
            <description>Returns the Z coordinate.</description>
        </method>
        <method name="Distance" qualifiers="const">
            <description>Returns the distance between two points.</description>
        </method>
        <method name="DumpJson" qualifiers="const">
            <description>Dumps the content of me into the stream</description>
        </method>
    </methods>
</class>