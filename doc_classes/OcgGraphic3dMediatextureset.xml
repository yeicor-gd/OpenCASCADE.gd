<?xml version='1.0' encoding='utf-8'?>
<class name="OcgGraphic3dMediatextureset" inherits="RefCounted">
    <brief_description>Texture adapter for Media_Frame.</brief_description>
    <description>! Texture adapter for Media_Frame.</description>
    <methods>
        <method name="Graphic3d_MediaTextureSet" qualifiers="static">
            <description>Empty constructor.</description>
        </method>
        <method name="Notify">
            <description>Call callback.</description>
        </method>
        <method name="PlayerContext" qualifiers="const">
            <description>Return player context; it can be NULL until first OpenInput().</description>
        </method>
        <method name="SwapFrames">
            <description>Swap front/back frames.</description>
        </method>
        <method name="ShaderProgram" qualifiers="const">
            <description>Return shader program for displaying texture set.</description>
        </method>
        <method name="IsPlanarYUV" qualifiers="const">
            <description>Return TRUE if texture set defined 3 YUV planes.</description>
        </method>
        <method name="IsFullRangeYUV" qualifiers="const">
            <description>Return TRUE if YUV range is full.</description>
        </method>
        <method name="Duration" qualifiers="const">
            <description>Return duration in seconds.</description>
        </method>
        <method name="Progress" qualifiers="const">
            <description>Return playback progress in seconds.</description>
        </method>
    </methods>
</class>