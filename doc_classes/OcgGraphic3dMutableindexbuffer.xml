<?xml version='1.0' encoding='utf-8'?>
<class name="OcgGraphic3dMutableindexbuffer" inherits="RefCounted">
    <brief_description>Mutable index buffer.</brief_description>
    <description>! Mutable index buffer.</description>
    <methods>
        <method name="InvalidatedRange" qualifiers="const">
            <description>Return invalidated range.</description>
        </method>
        <method name="Validate">
            <description>Reset invalidated range.</description>
        </method>
        <method name="Invalidate">
            <description>Invalidate the entire buffer data.</description>
        </method>
        <method name="invalidate">
            <description>Invalidate specified sub-range of data (as byte offsets).</description>
        </method>
    </methods>
</class>