<?xml version='1.0' encoding='utf-8'?>
<class name="OcgAspectWindow" inherits="RefCounted">
    <brief_description>Defines a window.</brief_description>
    <description>! Defines a window.</description>
    <methods>
        <method name="IsVirtual" qualifiers="const">
            <description>Returns True if the window &lt;me&gt; is virtual</description>
        </method>
        <method name="SetVirtual">
            <description>Setup the virtual state</description>
        </method>
        <method name="DisplayConnection" qualifiers="const">
            <description>Returns connection to Display or NULL.</description>
        </method>
        <method name="Background" qualifiers="const">
            <description>Returns the window background.</description>
        </method>
        <method name="BackgroundFillMethod" qualifiers="const">
            <description>Returns the current image background fill mode.</description>
        </method>
        <method name="GradientBackground" qualifiers="const">
            <description>Returns the window gradient background.</description>
        </method>
        <method name="SetBackground_1">
            <description>Modifies the window background.</description>
        </method>
        <method name="SetBackground_2">
            <description>Modifies the window background.</description>
        </method>
        <method name="SetBackground_3">
            <description>Modifies the window gradient background.</description>
        </method>
        <method name="SetBackground_4">
            <description>Modifies the window gradient background.</description>
        </method>
        <method name="InvalidateContent">
            <description>Invalidate entire window content.</description>
        </method>
        <method name="DevicePixelRatio" qualifiers="const">
            <description>Return device pixel ratio (logical to backing store scale factor).</description>
        </method>
        <method name="DumpJson" qualifiers="const">
            <description>Dumps the content of me into the stream</description>
        </method>
    </methods>
</class>