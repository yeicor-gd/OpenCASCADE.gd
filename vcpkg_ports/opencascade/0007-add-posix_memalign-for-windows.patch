From: opencode <opencode@local>
Date: 2026-08-28
Subject: [PATCH] Add posix_memalign implementation for Windows/mingw

Windows does not provide posix_memalign; use _aligned_malloc instead.
This is needed for arm64-mingw builds where the symbol is undefined.

---
 src/FoundationClasses/TKernel/Standard/Standard.cxx | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/FoundationClasses/TKernel/Standard/Standard.cxx b/src/FoundationClasses/TKernel/Standard/Standard.cxx
index 1234567..abcdefg 100644
--- a/src/FoundationClasses/TKernel/Standard/Standard.cxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard.cxx
@@ -1,3 +1,15 @@
+// Windows does not provide posix_memalign; provide a compatible implementation
+#if defined(_WIN32) && !defined(__CYGWIN__)
+#include <malloc.h>
+static inline int posix_memalign(void** memptr, size_t alignment, size_t size) {
+    void* ptr = _aligned_malloc(size, alignment);
+    if (ptr == NULL) {
+        return ENOMEM;
+    }
+    *memptr = ptr;
+    return 0;
+}
+#endif
+
 //=======================================================================
 //function : Standard::AllocateAligned
 //purpose  :
@@ -480,6 +492,13 @@ void* Standard::AllocateAligned(const size_t theSize, const size_t theAlignment)
 
 #if defined(_WIN32) && !defined(__CYGWIN__)
     // On Windows we use _aligned_malloc
+#if !defined(posix_memalign)
+    void* ptr = _aligned_malloc(theSize, theAlignment);
+    if (ptr == nullptr) {
+        Standard_OutOfMemory::Raise(theSize);
+    }
+    return ptr;
+#else
     int ret = posix_memalign(&ptr, theAlignment, theSize);
     if (ret != 0) {
         Standard_OutOfMemory::Raise(theSize);
@@ -490,7 +509,7 @@ void* Standard::AllocateAligned(const size_t theSize, const size_t theAlignment)
         Standard_OutOfMemory::Raise(theSize);
     }
     return ptr;
-#endif
+#endif
 #else
     // On other platforms we use posix_memalign
     int ret = posix_memalign(&ptr, theAlignment, theSize);