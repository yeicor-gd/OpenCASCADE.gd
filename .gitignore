# Ignore autowrapper-generated files (regenerated by OpenCASCADE.gd-autowrapper)
/src/autowrapper/
/doc_classes/*.xml
/doc_classes/autowrapper/

# Auto-generated sweep test suites (regenerated by generate.sh / validate.sh)
/demo/tests/autowrapper/test_sweep_*.gd
/demo/tests/autowrapper/test_sweep_*.gd.uid

# Stray empty file written by sweep tests that call file-IO methods
/demo/s

# Build artifacts.
/build/
/build-gcc/
/demo/templates/

# IDEs
/.idea/
/.vscode/
compile_commands.json
/.cache/

# VCPKG
/vcpkg_ports/*/.last_build
/vcpkg_installed/
demo/addons/OpenCASCADE.gd/*.so
.build-autowrapper/
