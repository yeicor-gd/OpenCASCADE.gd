# Ignore autowrapper-generated files (regenerated by OpenCASCADE.gd-autowrapper)
/src/autowrapper/
/doc_classes/*.xml
/doc_classes/autowrapper/

# Build artifacts.
/build/
/build-gcc/
/demo/templates/

# IDEs
/.idea/
/.vscode/
compile_commands.json
/.cache/

# VCPKG
/vcpkg_ports/*/.last_build
/vcpkg_installed/

# Prebuilt GDExtension library files (downloaded by the editor plugin from GitHub Actions).
# Ignored exhaustively: the addon only ships sources + config, binaries come from CI.
demo/addons/OpenCASCADE.gd/*.so
demo/addons/OpenCASCADE.gd/*.so.*
demo/addons/OpenCASCADE.gd/*.dll
demo/addons/OpenCASCADE.gd/*.dylib
demo/addons/OpenCASCADE.gd/*.wasm
demo/addons/OpenCASCADE.gd/*.pdb

.build-autowrapper/
